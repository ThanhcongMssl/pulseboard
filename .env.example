# Apps running on the host. directConnection skips replica-set discovery,
# whose member hostname ("mongo") only resolves inside the compose network.
MONGO_URL=mongodb://localhost:27017/pulseboard?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
