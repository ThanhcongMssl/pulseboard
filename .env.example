# Apps running on the host. directConnection skips replica-set discovery,
# whose member hostname ("mongo") only resolves inside the compose network.
MONGO_URL=mongodb://localhost:27017/pulseboard?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Worker: schedule interval, default backfill depth, and a share of connector
# fetches to fail on purpose (0–1) to demo retries and stale sources.
INGEST_EVERY_MINUTES=360
BACKFILL_DAYS=30
CONNECTOR_FAILURE_RATE=0
